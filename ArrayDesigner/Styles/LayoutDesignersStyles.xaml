<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ArrayDesigner.ViewModels">

    <DataTemplate DataType="{x:Type vm:LayoutDesignerViewModel}">
        <DataTemplate.Resources>
            <Multiply x:Key="Div2" Parameter="0.5"/>
            <TranslateTransform x:Key="T-2" X="-2.5" Y="-2.5"/>
        </DataTemplate.Resources>
        <Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" ClipToBounds="False">
                    <Viewbox>
                        <Border BorderThickness="1" BorderBrush="Red">
                            <ListBox Margin="-0"  Width="110" Height="110"
                                     BorderThickness="0"
                                     Padding="10"
                                     ItemsSource="{Binding MainModel.Items}"
                                     Canvas.Left="0"
                                     Canvas.Top="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Margin="10"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y, Mode=OneWay}"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RenderTransform="{StaticResource T-2}" Width="5" Height="5">
                                            <Ellipse StrokeThickness="1" Stroke="Blue" Fill="Transparent"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Viewbox>
                </Border>
                <GroupBox Grid.Column="1" Header="Дизайнер">
                    <Grid>
                        <ListBox ItemsSource="{Binding MainModel.Items}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Header="{Binding Index, Mode=OneTime}" Margin="2">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="X:" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Y:" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>